# ==============================================================================
# Production Deployment .gitignore
# Ensures only clean application code, deployment configs, and production assets
# are tracked and pushed for deployment.
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# Production & Local Environment Variables (Secrets)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.local
*.env

# Vercel & Hosting Artifacts
.vercel

# Testing & Coverage Reports
/coverage
*.lcov
.nyc_output

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# OS & File System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Specification Documents & Raw Unused Media Staging
# (All active production assets reside in /public)
*.pdf
/asset/

# Agent Workspaces, Internal Tooling & Non-Deployment Scaffolding
/.agent/
/.agents/
/.gemini/
/.gsd/
/adapters/
/scripts/
PROJECT_RULES.md
GSD-STYLE.md
model_capabilities.yaml
VERSION

# Temporary Files & Archives
*.tmp
*.temp
*.bak
*.swp
*.patch
*.diff
*.zip
*.tar.gz
*.7z
